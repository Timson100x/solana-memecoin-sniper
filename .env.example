# === Helius Developer Plan ===
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# === Jupiter ===
JUPITER_API_URL=https://quote-api.jup.ag/v6

# === Jito (Anti-MEV) ===
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=10000
USE_JITO=true

# === Wallet ===
PRIVATE_KEY=your_base58_private_key_here

# === Bot Settings ===
SCAN_INTERVAL_SECS=6
SCORE_THRESHOLD=70.0
MIN_VOLUME_5M_SOL=15.0
MAX_WATCHLIST_SIZE=500
INACTIVE_TIMEOUT_MINS=15
MIN_SCORE_TO_KEEP=10.0

# === Risk Management ===
ENABLE_LIVE_TRADING=false
BUY_AMOUNT_SOL=0.05
SLIPPAGE_BPS=300
PRIORITY_FEE_LAMPORTS=100000
MAX_DAILY_LOSS_SOL=0.5
MAX_TOP10_HOLDERER_PCT=45.0
TAKE_PROFIT_PCT=50.0
STOP_LOSS_PCT=20.0
MAX_HOLD_MINUTES=45

# === Logging ===
TRADE_LOG_PATH=./trade_log.jsonl
" filePath="/workspace/app/.env.example
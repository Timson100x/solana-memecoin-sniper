HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=

# === Jupiter ===
JUPITER_API_KEY=
JUPITER_API_URL=https://quote-api.jup.ag/v6

# === Wallet (NEVER commit!) ===
SOLANA_WALLET_PRIVATE_KEY=

# === Mode (default: paper trading) ===
ENABLE_LIVE_TRADING=false
EXECUTION_CONFIRMATION=

# === Trading params ===
BUY_AMOUNT_SOL=0.05
SLIPPAGE_BPS=400
PRIORITY_FEE_LAMPORTS=100000
MAX_DAILY_LOSS_SOL=0.5
MAX_TRADE_SOL=0.05
MAX_OPEN_POSITIONS=5
MAX_HOLD_MINUTES=45

# === Observability ===
TRADE_LOG_PATH=./logs/trade_log.jsonl
LOG_LEVEL=info

# === Telegram (optional) ===
TELEGRAM_BOT_TOKEN=

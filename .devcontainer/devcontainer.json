{
  "name": "solana-trading-bot",
  "image": "mcr.microsoft.com/devcontainers/rust:1.82-bookworm",
  "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],
  "postCreateCommand": "bash scripts/bootstrap.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tauri-apps.basedpng",
        "tamasfe.even-better-toml",
        "editorconfig.editorconfig",
        "github.vscode-github-actions"
      ]
    }
  },
  "features": {
    "recommendCli": "true"
  },
  "hostRequirements": {
    "cpus": 4
  },
  "recommendedSecrets": {
    "HELIUS_API_KEY": {
      "description": "Helius API key for RPC/WebSocket access"
    },
    "HELIUS_RPC_URL": { "description": "Helius mainnet RPC URL" },
    "HELIUS_WS_URL": { "description": "Helius mainnet WebSocket URL" },
    "JUPITER_API_KEY": { "description": "Jupiter API key (optional)" },
    "SOLANA_WALLET_PRIVATE_KEY": {
      "description": "Base58 Solana private key (leave empty for paper trading)"
    },
    "TELEGRAM_BOT_TOKEN": { "description": "Telegram bot token (optional)" },
    "TELEGRAM_CHAT_ID": { "description": "Telegram chat id (optional)" }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "onCreateCommand": "apt-get update && apt-get install -y --no-install-recommends build-essential pkg-config libssl-dev clang cmake protobuf-compiler git curl jq unzip",
  "updateHostRequirements": []
}
